# Narok Talk Sasa - Backend Environment Variables
PORT=3000
NODE_ENV=development

# Allowed CORS Origins (comma-separated or * for wildcard)
# Examples:
# CORS_ORIGIN=http://localhost:5000,http://localhost:5173,https://your-frontend.vercel.app,capacitor://localhost,https://localhost
CORS_ORIGIN=*

# Path for file uploads (defaults to ./uploads)
UPLOAD_DIR=./uploads

# Database configuration (defaults to ./database/data.json)
DATA_FILE=./database/data.json
