# ============================================================
# NAROK TALK SASA — Backend Environment Variables
# Copy this file to .env and fill in real values
# ============================================================

# ── Server Config ─────────────────────────────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*
UPLOAD_DIR=./uploads

# ── Supabase (primary database) ───────────────────────────
# Your project URL (Settings > API in Supabase dashboard)
SUPABASE_URL=https://pqkgkfgvwlsvcwjkptoy.supabase.co
# Service Role key — backend only, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Publishable key (anon key) — safe for browser clients
NEXT_PUBLIC_SUPABASE_URL=https://pqkgkfgvwlsvcwjkptoy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_z--lu40gFNcIoXWIQTwXFQ_fC7S02Km

# ── Africa's Talking ──────────────────────────────────────
AT_USERNAME=your_africas_talking_username
AT_API_KEY=your_africas_talking_api_key
AT_SENDER_ID=NAROK_TALK
AT_SHORTCODE=your_shortcode
AT_CALLER_ID=your_caller_id_for_voice
AT_USSD_SERVICE_CODE=*123#

# ── WhatsApp Business Cloud API (Meta) ────────────────────
META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
META_WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
META_WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token

# ── Meta Facebook / Instagram Ads ─────────────────────────
META_FB_AD_ACCOUNT_ID=act_your_ad_account_id
META_FB_ACCESS_TOKEN=your_facebook_ads_access_token
META_PIXEL_ID=your_pixel_id

# ── X (Twitter) Ads API ───────────────────────────────────
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret
X_AD_ACCOUNT_ID=your_x_ads_account_id

# ── SendGrid Email ─────────────────────────────────────────
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@naroktalksasa.ke
SENDGRID_FROM_NAME=Narok Talk Sasa
